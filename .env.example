# Elsewhere environment variables.
# Copy to .env.local for local development. Never commit real values.
# Everything here is read on the server only, except variables prefixed NEXT_PUBLIC_.

# --- Image generation (OpenAI) ----------------------------------------------
# Enables live generation, AI concepts, prompt refinement and visual review.
# Without it, Elsewhere runs in development mode with labelled sketches.
OPENAI_API_KEY=
# Optional overrides. Any model ID works; unknown IDs run with conservative settings.
# Default image model: gpt-image-2.6-flare. Default text model: gpt-5.5.
OPENAI_IMAGE_MODEL=
OPENAI_TEXT_MODEL=
# Optional: organisation ID and a custom base URL (for proxies or gateways).
OPENAI_ORG_ID=
OPENAI_BASE_URL=

# --- Supabase (production persistence, auth and storage) -------------------
# When both are set, Elsewhere uses Supabase with Row Level Security.
# When empty, it uses the local development store in ELSEWHERE_DATA_DIR.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (sb_publishable_...) or legacy anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Elsewhere ---------------------------------------------------------------
# Force a data mode: "local" or "supabase". Defaults to supabase when configured.
ELSEWHERE_DATA_MODE=
# Local development store location (JSON database and image files).
ELSEWHERE_DATA_DIR=.elsewhere-data
# Development sketch provider: "1" to enable, "0" to disable. Defaults to on in local mode.
ELSEWHERE_DEV_PROVIDER=
# Server-side ceiling on images per user per day, regardless of user settings.
ELSEWHERE_HARD_DAILY_IMAGE_CAP=200
